server {
    listen 8080;
    root /usr/share/nginx/html;

    # Security headers. The CSP allows only this origin plus the S3 endpoint the browser uploads to;
    # with no inline scripts, an injected <script> can't run or exfiltrate the session token.
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${S3_ORIGIN}; img-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Same-origin API: the browser never talks to Django directly, so no CORS is needed.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
    }

    # Hashed build assets can be cached forever; index.html must not be.
    # Hashed build assets can be cached forever; index.html must not be. Cache-Control is set with
    # `expires` so these blocks don't need their own add_header (which would drop the ones above).
    location /assets/ {
        expires max;
    }

    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
